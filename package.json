{
  "name": "omni-ui",
  "version": "0.1.0",
  "description": "Omni 系列桌面应用（OmniZip、Omni Download）共用的设计令牌、主题与 React 组件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoidDel/omni-ui.git"
  },
  "homepage": "https://github.com/VoidDel/omni-ui#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test",
    "themes:gen": "node scripts/gen-builtin-themes.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  }
}
